MSSQL_SA_PASSWORD=CHANGE_ME
RABBITMQ_USER=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
ASPNETCORE_ENVIRONMENT=Production

# Habilita POST /diagnostics/replay-order-created en Inventory Worker (puerto 8081) para
# verificar manualmente la idempotencia del worker. No es parte del contrato de la prueba;
# dejar en false salvo que se esté haciendo esa verificación puntual.
ENABLE_DIAGNOSTICS=false

# Origen exacto desde el que el navegador sirve el frontend (OrdersFlow.Frontend).
# Usado por Orders API para la politica CORS (sin wildcard) y por SignalR para el negotiate.
FRONTEND_ORIGIN=http://localhost:8082

